{
  "name": "mediasniff",
  "version": "2.0.0",
  "description": "Cross-browser MV3 extension to detect and download video/audio stream URLs (HLS, DASH, MP4, WebM, subtitles).",
  "keywords": ["media", "video", "audio", "download", "sniffer", "hls", "dash", "m3u8", "mpd", "stream", "firefox", "chrome", "extension", "mv3", "webextension"],
  "private": true,
  "scripts": {
    "test": "node tests/media.test.js && node tests/integration.test.js",
    "build": "bash build.sh",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "helper": "python3 helper/grab.py",
    "setup": "bash install.sh"
  },
  "license": "MIT"
}
